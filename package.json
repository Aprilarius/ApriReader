{
  "name": "aprireader",
  "private": true,
  "version": "0.9.0-beta.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "test": "vitest run --configLoader runner",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "release:audit": "python scripts/release_audit.py && python scripts/generate_sbom.py --check",
    "check": "pnpm format && pnpm lint && pnpm test && pnpm build && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test && pnpm release:audit",
    "beta:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_beta_candidate.ps1",
    "tauri": "tauri",
    "tauri:steam": "tauri build --config src-tauri/tauri.steam.conf.json --features steam-build --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "pdfjs-dist": "5.7.284",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@tauri-apps/cli": "2.8.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.39.0",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.9.0"
}
