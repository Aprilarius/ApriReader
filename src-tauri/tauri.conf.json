{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApriReader",
  "version": "../package.json",
  "identifier": "com.aprireader.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ApriReader",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/covers/**",
          "$APPLOCALDATA/fonts/**",
          "$APPLOCALDATA/readers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "publisher": "Bahadur",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "category": "Reference",
    "shortDescription": "Privacy-first desktop reader and personal library",
    "longDescription": "ApriReader is a local-first reader and personal library for DRM-free books on Windows.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
